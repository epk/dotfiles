{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "nix": {
    "enabled": true
  },
  "automerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 0-5 * * 1"
    ]
  },
  "customDatasources": {
    "antigravity": {
      "defaultRegistryUrlTemplate": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":$match(url,/antigravity-cli\\/([0-9.]+-[0-9]+)\\/linux-x64\\//).groups[0],\"digest\":sha512}]}"
      ]
    },
    "chrome-devtools-mcp": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/chrome-devtools-mcp/latest",
      "transformTemplates": [
        "{\"releases\":[{\"version\":version,\"digest\":dist.integrity}]}"
      ]
    },
    "cua-driver": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[$exists($match(tag_name, /^cua-driver-rs-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-driver-rs-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-driver-rs-[0-9.]+-linux-x86_64-binary\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    },
    "cua-spacesd": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[prerelease = false and $exists($match(tag_name, /^cua-spacesd-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-spacesd-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-spacesd-linux-x86_64\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    },
    "cua-cli": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[prerelease = false and $exists($match(tag_name, /^cua-sdk-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-sdk-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-cli-[0-9.]+-linux-x64\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/antigravity-release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"[0-9.]+\",\\s+\"url\": \"https://storage\\.googleapis\\.com/antigravity-public/antigravity-cli/(?<currentValue>[0-9.]+-[0-9]+)/linux-x64/cli_linux_x64\\.tar\\.gz\",\\s+\"sha512\": \"(?<currentDigest>[0-9a-f]{128})\""
      ],
      "autoReplaceStringTemplate": "\"version\": \"{{lookup (split newValue '-') 0}}\",\n  \"url\": \"https://storage.googleapis.com/antigravity-public/antigravity-cli/{{{newValue}}}/linux-x64/cli_linux_x64.tar.gz\",\n  \"sha512\": \"{{{newDigest}}}\"",
      "depNameTemplate": "antigravity-cli",
      "datasourceTemplate": "custom.antigravity",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/chrome-devtools-mcp-release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"hash\": \"(?<currentDigest>sha512-[^\"]+)\""
      ],
      "autoReplaceStringTemplate": "\"version\": \"{{{newValue}}}\",\n  \"hash\": \"{{{newDigest}}}\"",
      "depNameTemplate": "chrome-devtools-mcp",
      "datasourceTemplate": "custom.chrome-devtools-mcp",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/homebrew-release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"rev\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "autoReplaceStringTemplate": "\"version\": \"{{{newValue}}}\",\n  \"rev\": \"{{{newDigest}}}\"",
      "depNameTemplate": "Homebrew/brew",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/tailscale-release\\.json$/"
      ],
      "matchStrings": [
        "\"tag\": \"(?<currentValue>v[0-9.]+)\",\\s+\"rev\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "autoReplaceStringTemplate": "\"tag\": \"{{{newValue}}}\",\n  \"rev\": \"{{{newDigest}}}\"",
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/cua-release\\.json$/"
      ],
      "matchStrings": [
        "\"driver\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"url\": \"[^\"\\n]+\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "autoReplaceStringTemplate": "\"driver\": {\n    \"version\": \"{{{newValue}}}\",\n    \"url\": \"https://github.com/trycua/cua/releases/download/cua-driver-rs-v{{{newValue}}}/cua-driver-rs-{{{newValue}}}-linux-x86_64-binary.tar.gz\",\n    \"sha256\": \"{{{newDigest}}}\"",
      "depNameTemplate": "cua-driver",
      "datasourceTemplate": "custom.cua-driver",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/cua-release\\.json$/"
      ],
      "matchStrings": [
        "\"spacesd\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"url\": \"[^\"\\n]+\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "autoReplaceStringTemplate": "\"spacesd\": {\n    \"version\": \"{{{newValue}}}\",\n    \"url\": \"https://github.com/trycua/cua/releases/download/cua-spacesd-v{{{newValue}}}/cua-spacesd-linux-x86_64.tar.gz\",\n    \"sha256\": \"{{{newDigest}}}\"",
      "depNameTemplate": "cua-spacesd",
      "datasourceTemplate": "custom.cua-spacesd",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/cua-release\\.json$/"
      ],
      "matchStrings": [
        "\"cli\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"url\": \"[^\"\\n]+\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "autoReplaceStringTemplate": "\"cli\": {\n    \"version\": \"{{{newValue}}}\",\n    \"url\": \"https://github.com/trycua/cua/releases/download/cua-sdk-v{{{newValue}}}/cua-cli-{{{newValue}}}-linux-x64.tar.gz\",\n    \"sha256\": \"{{{newDigest}}}\"",
      "depNameTemplate": "cua-cli",
      "datasourceTemplate": "custom.cua-cli",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "/^https://flakehub\\.com//"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    }
  ],
  "timezone": "America/La_Paz"
}
