{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "nix": {
    "enabled": true
  },
  "automerge": true,
  "automergeStrategy": "squash",
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 0-5 * * *"
    ]
  },
  "customDatasources": {
    "antigravity": {
      "defaultRegistryUrlTemplate": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":$match(url,/antigravity-cli\\/([0-9.]+-[0-9]+)\\/linux-x64\\//).groups[0],\"digest\":sha512}]}"
      ]
    },
    "cua-driver": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[$exists($match(tag_name, /^cua-driver-rs-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-driver-rs-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-driver-rs-[0-9.]+-linux-x86_64-binary\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    },
    "cua-spacesd": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[prerelease = false and $exists($match(tag_name, /^cua-spacesd-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-spacesd-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-spacesd-linux-x86_64\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    },
    "cua-cli": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/trycua/cua/releases?per_page=100",
      "transformTemplates": [
        "{\"releases\": $map($[prerelease = false and $exists($match(tag_name, /^cua-sdk-v[0-9.]+$/))], function($r) { {\"version\": $substringAfter($r.tag_name, \"cua-sdk-v\"), \"digest\": $substringAfter($r.assets[$exists($match(name, /^cua-cli-[0-9.]+-linux-x64\\.tar\\.gz$/))].digest, \"sha256:\")} })}"
      ]
    },
    "vscode": {
      "defaultRegistryUrlTemplate": "https://update.code.visualstudio.com/api/update/darwin-arm64/stable/latest",
      "transformTemplates": [
        "{\"releases\":[{\"version\":productVersion,\"digest\":sha256hash}]}"
      ]
    },
    "npm": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/{{packageName}}",
      "transformTemplates": [
        "{\"releases\":[{\"version\":$replace(version, /-(darwin|linux|win32)-(arm64|x64)$/, \"\"),\"digest\":dist.integrity}]}"
      ]
    },
    "homebrew-cask": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/cask/{{packageName}}.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":version,\"digest\":sha256}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/antigravity-cli/release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"[0-9.]+\",\\s+\"url\": \"https://storage\\.googleapis\\.com/antigravity-public/antigravity-cli/(?<currentValue>[0-9.]+-[0-9]+)/linux-x64/cli_linux_x64\\.tar\\.gz\",\\s+\"sha512\": \"(?<currentDigest>[0-9a-f]{128})\""
      ],
      "autoReplaceStringTemplate": "\"version\": \"{{lookup (split newValue '-') 0}}\",\n  \"url\": \"https://storage.googleapis.com/antigravity-public/antigravity-cli/{{{newValue}}}/linux-x64/cli_linux_x64.tar.gz\",\n  \"sha512\": \"{{{newDigest}}}\"",
      "depNameTemplate": "antigravity-cli",
      "datasourceTemplate": "custom.antigravity",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/chrome-devtools-mcp/release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"hash\": \"(?<currentDigest>sha512-[^\"]+)\""
      ],
      "depNameTemplate": "chrome-devtools-mcp",
      "datasourceTemplate": "custom.npm",
      "versioningTemplate": "semver",
      "packageNameTemplate": "chrome-devtools-mcp/latest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/homebrew/release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"rev\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "Homebrew/brew",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/tailscale/release\\.json$/"
      ],
      "matchStrings": [
        "\"tag\": \"(?<currentValue>v[0-9.]+)\",\\s+\"rev\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/cua/release\\.json$/"
      ],
      "matchStrings": [
        "\"(?<packageName>driver|spacesd|cli)\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "cua-{{{packageName}}}",
      "datasourceTemplate": "custom.cua-{{{packageName}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/claude-code/release\\.json$/"
      ],
      "matchStrings": [
        "\"(?<packageName>[a-z0-9-]+)\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"hash\": \"(?<currentDigest>sha512-[^\"]+)\""
      ],
      "depNameTemplate": "claude-code-{{{packageName}}}",
      "datasourceTemplate": "custom.npm",
      "versioningTemplate": "semver",
      "packageNameTemplate": "@anthropic-ai/claude-code-{{{packageName}}}/latest"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/codex/release\\.json$/"
      ],
      "matchStrings": [
        "\"(?<packageName>[a-z0-9-]+)\": \\{\\s+\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"hash\": \"(?<currentDigest>sha512-[^\"]+)\""
      ],
      "depNameTemplate": "codex-{{{packageName}}}",
      "datasourceTemplate": "custom.npm",
      "versioningTemplate": "semver",
      "packageNameTemplate": "@openai/codex/{{{packageName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/vscode/release\\.json$/"
      ],
      "matchStrings": [
        "\"version\": \"(?<currentValue>[0-9.]+)\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "vscode",
      "datasourceTemplate": "custom.vscode",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/(1password|1password-cli|ghostty-bin|slack|tuple)/release\\.json$/"
      ],
      "matchStrings": [
        "\"cask\": \"(?<packageName>[a-z0-9-]+)\",\\s+\"version\": \"(?<currentValue>[^\"]+)\",\\s+\"sha256\": \"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "depNameTemplate": "{{{packageName}}}",
      "datasourceTemplate": "custom.homebrew-cask",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:,.+)?$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "/^https://flakehub\\.com//"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "/^claude-code-/"
      ],
      "groupName": "claude-code"
    },
    {
      "matchDepNames": [
        "/^codex-/"
      ],
      "groupName": "codex"
    },
    {
      "matchDepNames": [
        "1password",
        "1password-cli"
      ],
      "groupName": "1password"
    }
  ],
  "timezone": "America/La_Paz"
}
